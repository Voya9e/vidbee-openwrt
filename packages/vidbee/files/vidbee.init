#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

base=/usr/lib/vidbee

valid_port() {
	case "$1" in
		''|0*|*[!0-9]*) return 1 ;;
	esac
	[ "${#1}" -le 5 ] && [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}

prepare_directory() {
	local path="$1"

	case "$path" in
		/?*) ;;
		*) return 1 ;;
	esac

	if [ ! -e "$path" ]; then
		mkdir -p "$path" && chown vidbee:vidbee "$path" && chmod 0750 "$path" || return 1
	fi

	[ -d "$path" ]
}

start_service() {
	local enabled api_port web_host web_port data_dir download_dir max_concurrent

	config_load vidbee
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get api_port main api_port 3100
	config_get web_host main web_host 0.0.0.0
	config_get web_port main web_port 3000
	config_get data_dir main data_dir /srv/vidbee/data
	config_get download_dir main download_dir /srv/vidbee/downloads
	config_get max_concurrent main max_concurrent 1

	if ! valid_port "$api_port" || ! valid_port "$web_port" || [ "$api_port" = "$web_port" ]; then
		logger -t vidbee 'Configure two distinct ports between 1024 and 65535.'
		return 1
	fi

	case "$max_concurrent" in
		[1-9]|10) ;;
		*)
			logger -t vidbee 'Set max_concurrent to an integer from 1 to 10.'
			return 1
			;;
	esac

	if ! prepare_directory "$data_dir" || ! prepare_directory "$download_dir"; then
		logger -t vidbee 'Could not prepare the configured data or download directory.'
		return 1
	fi

	procd_open_instance api
	procd_set_param command "$base/start-api"
	procd_set_param user vidbee
	procd_set_param group vidbee
	procd_set_param env \
		"NODE_ENV=production" \
		"NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt" \
		"HOME=$data_dir" \
		"YTDLP_PATH=/usr/bin/yt-dlp" \
		"FFMPEG_PATH=/usr/bin/ffmpeg" \
		"VIDBEE_API_HOST=127.0.0.1" \
		"VIDBEE_API_PORT=$api_port" \
		"VIDBEE_DATA_DIR=$data_dir" \
		"VIDBEE_DOWNLOAD_DIR=$download_dir" \
		"VIDBEE_MIGRATIONS_DIR=$base/api/resources/drizzle" \
		"VIDBEE_MAX_CONCURRENT=$max_concurrent"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	procd_open_instance web
	procd_set_param command "$base/node/bin/node" "$base/web/server.mjs"
	procd_set_param user vidbee
	procd_set_param group vidbee
	procd_set_param env \
		"NODE_ENV=production" \
		"HOME=$data_dir" \
		"VIDBEE_API_URL_INTERNAL=http://127.0.0.1:$api_port" \
		"VIDBEE_WEB_HOST=$web_host" \
		"VIDBEE_WEB_PORT=$web_port"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vidbee
}
